    "def load_not_wild_images(max_len_class, file_path=str):\n",
    "    X = []\n",
    "    y = []\n",
    "    images = []\n",
    "    label = int\n",
    "    for fpath in glob.glob(file_path):\n",
    "        if count >= max_len_class:\n",
    "            break\n",
    "        image = cv2.imread(fpath, cv2.IMREAD_GRAYSCALE)\n",
    "        images.append(image)\n",
    "        X.append(image)\n",
    "        y.append(0)\n",
    "        count += 1\n",
    "    X = np.array(X)\n",
    "    y = np.array(y)\n",
    "    return X, y\n",
    "\n",
    "def load_wild_images(max_len_class, file_path=str):\n",
    "    X = []\n",
    "    y = []\n",
    "    images = []\n",
    "    label = int\n",
    "    for fpath in glob.glob(file_path):\n",
    "        if count >= max_len_class:\n",
    "            break\n",
    "        image = cv2.imread(fpath, cv2.IMREAD_GRAYSCALE)\n",
    "        images.append(image)\n",
    "        X.append(image)\n",
    "        y.append(1)\n",
    "        count += 1\n",
    "    X = np.array(X)\n",
    "    y = np.array(y)\n",
    "    return X, y\n",
    "\n",
    "def load_images(max_len_class, not_wild_dir=str, wild_dir=str):\n",
    "    X, y = []\n",
    "    X1, y1 = load_not_wild_images(max_len_class, not_wild_dir)\n",
    "    X2, y2 = load_wild_images(max_len_class, wild_dir)\n",
    "    \n",
    "    X.append(X1)\n",
    "    X.append(X2)\n",
    "    y.append(y1)\n",
    "    y.append(y2)\n",
    "    return X, y"
   ]
