    "def resize_images(image_data, w, h):\n",
    "    resized_imgs = []\n",
    "    for img in image_data:\n",
    "        resized_img = cv2.resize(img, (w, h))\n",
    "        resized_imgs.append(resized_img)\n",
    "    \n",
    "    resized_imgs = np.array(resized_imgs)\n",
    "    return resized_imgs"
   ]
